# Порт на хосте, на котором subwave увидит TTS-сервер.
# В subwave: Admin → Settings → Voices → Default engine → Remote
# Server URL = http://host.docker.internal:<TTS_PORT>  (или LAN-IP машины)
TTS_PORT=5001

# Голос по умолчанию (fallback), если voice из subwave не совпал.
# Доступные: aidar, baya, kseniya, xenia, eugene
TTS_DEFAULT_VOICE=xenia

# Sample rate отдаваемого WAV (8000 / 24000 / 48000)
TTS_SAMPLE_RATE=48000

# Число потоков CPU (0 = все доступные ядра)
TTS_NUM_THREADS=0

# Транслитерировать латинские названия в кириллицу (0/1). По умолчанию выключено.
# Включи, если хочешь, чтобы английские названия песен озвучивались.
TTS_TRANSLIT=0
